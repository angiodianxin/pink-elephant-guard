# Build artifacts (binaries are distributed via GitHub Releases, not Git)
bin/

# Runtime intermediate file — must never be committed (may contain user content)
pink-elephant-manifest.json

# `go build` を -o なしで scan/ 内で実行したときに残る実行ファイル
scan/scan

# go.work のワークスペース sum（依存はモジュール側の go.sum が正本）
go.work.sum
